# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Model pipeline artifacts are large generated files; keep only directory markers.
/model_pipeline/artifacts/**
!/model_pipeline/artifacts/**/
!/model_pipeline/artifacts/**/.gitkeep
# Commit only the deployable Android INT8 bundle and multilingual Whisper
# model. Source, FP16/FP32, and experimental exports stay local.
!/model_pipeline/artifacts/onnx/
!/model_pipeline/artifacts/onnx/int8-dynamic/
!/model_pipeline/artifacts/onnx/int8-dynamic/**
!/model_pipeline/artifacts/whisper/
!/model_pipeline/artifacts/whisper/**
/model_pipeline/.venv/
